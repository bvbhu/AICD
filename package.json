{
  "name": "dsh-shotflow",
  "version": "0.3.0",
  "description": "DSH plugin bundle for AI video generation workflows: ChatGPT web tools, image tools (model_list + image_generation), ffmpeg video analysis, and credit-free Pixmax operations",
  "type": "module",
  "main": "./src/chat-tools.mjs",
  "exports": {
    ".": "./src/chat-tools.mjs",
    "./chat": "./src/chat-tools.mjs",
    "./image": "./src/image-tools.mjs",
    "./video": "./src/video-tools.mjs",
    "./bridge": "./src/bridge.mjs",
    "./chatgpt": "./src/chatgpt.mjs",
    "./credentials": "./src/credentials.mjs",
    "./ffmpeg": "./src/ffmpeg.mjs",
    "./image-api": "./src/image-api.mjs",
    "./image-models": "./src/image-models.mjs",
    "./job-runner": "./src/job-runner.mjs",
    "./pixmax": "./src/pixmax-tools.mjs",
    "./settings": "./src/settings-host.mjs",
    "./sensenova": "./src/sensenova.mjs",
    "./video-frames": "./src/video-frames.mjs",
    "./store": "./src/store.mjs",
    "./client": "./client/shotflow-settings.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "gpt": "./bin/gpt.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "client/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chatgpt",
    "browser-control",
    "ffmpeg",
    "video",
    "ai-video",
    "sensenova",
    "pixmax",
    "agent-preset",
    "image-models",
    "image-generation",
    "settings"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
